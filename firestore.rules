rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // The project currently has a closed email/password admin login. Add an
      // `admin` custom claim here before enabling any public sign-in provider.
      return request.auth != null;
    }

    match /radios/{radioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /youtubers/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics_visits/{visitId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /{path=**}/analyticsDailyShards/{shardId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
